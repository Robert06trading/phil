# Copy to .env and fill in. NEVER commit .env.
# ---- mode -------------------------------------------------------------
# backtest | replay | paper | live
TRADER_MODE=paper
# ibkr (IBKR paper account, recommended) | paper (local simulator + IBKR data)
TRADER_BROKER=ibkr
# second switch; live also needs signed approval + evidence
TRADER_LIVE_TRADING_ENABLED=false
# only for TRADER_BROKER=paper; IBKR accounts report their own equity
TRADER_PAPER_STARTING_CAPITAL=
TRADER_BASE_CURRENCY=USD

# ---- IBKR (IB Gateway: 4002 paper / 4001 live; TWS: 7497 / 7496) -------
TRADER_IBKR_HOST=host.docker.internal
TRADER_IBKR_PORT=4002
TRADER_IBKR_CLIENT_ID=17
# e.g. DU1234567 (paper) — required if the login manages several accounts
TRADER_IBKR_ACCOUNT=

# ---- storage ----------------------------------------------------------
POSTGRES_PASSWORD=change-me
# TRADER_DATABASE_URL is set by docker-compose; default outside Docker: sqlite:///data/trader.db

# ---- API / dashboard security ------------------------------------------
# python main.py gen-token  (twice: admin + viewer) ; python main.py gen-totp
TRADER_API_ADMIN_TOKEN_SHA256=
TRADER_API_VIEWER_TOKEN_SHA256=
TRADER_API_TOTP_SECRET=
# long random string, e.g. python -c "import secrets;print(secrets.token_hex(32))"
TRADER_APPROVAL_HMAC_SECRET=
DOMAIN=trader.example.com

# ---- notifications (optional, informational only) -----------------------
TRADER_TELEGRAM_BOT_TOKEN=
TRADER_TELEGRAM_CHAT_ID=

# ---- risk (defaults shown; hard ceilings enforced in code) --------------
# TRADER_RISK__RISK_PER_TRADE_PCT=0.5
# TRADER_RISK__MAX_DAILY_LOSS_PCT=2.0
# TRADER_RISK__MAX_WEEKLY_LOSS_PCT=5.0
# TRADER_RISK__MAX_OPEN_POSITIONS=3
# TRADER_RISK__MIN_REWARD_RISK=2.0
# TRADER_RISK__MAX_PORTFOLIO_RISK_PCT=1.5
